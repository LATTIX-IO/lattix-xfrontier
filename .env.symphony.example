# Copy this file to the gitignored .env.symphony.local file.
LINEAR_API_KEY=replace-with-a-host-side-linear-personal-api-key
OMNIROUTE_API_KEY=replace-with-a-local-omniroute-dashboard-key

# The CI feedback identity is intentionally separate. Store its credential as
# the GitHub Actions secret LINEAR_CI_FEEDBACK_API_KEY; do not put it here.

# Optional route tuning.
SYMPHONY_NATIVE_MODEL=gpt-5.6-sol
# Examples advertised by a configured gateway may include auto/claude-opus
# and codex/gpt-5.6-sol. Keep auto for OmniRoute's reviewed routing policy.
SYMPHONY_OMNIROUTE_MODEL=auto
SYMPHONY_REASONING_EFFORT=high
