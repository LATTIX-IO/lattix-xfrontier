{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "local-stack",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-f", "docker-compose.local.yml", "up"],
      "port": 3000
    },
    {
      "name": "secure-stack",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "-f", "docker-compose.yml", "up"],
      "port": 8000
    }
  ]
}
